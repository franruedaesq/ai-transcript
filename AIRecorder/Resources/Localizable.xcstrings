          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird jetzt auf dem Hauptbildschirm angezeigt. iOS muss vor der Übersetzung möglicherweise Apple-Sprachpakete laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will now appear on the main screen. iOS may need to download Apple language packs before translating."
